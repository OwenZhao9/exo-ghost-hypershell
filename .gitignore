# Python
.venv/
__pycache__/
*.pyc

# 运行时产生的数据（每次 ENABLE 自动落盘，单个会话可达几十 MB）
data/*.csv
data/*.log
# 会话流水
data/*.jsonl
# 生成的交付单（示例见 docs/会话交付单-示例.html）
data/*.html
# 经验库，每次启动从 agent/capsules.py 自动播种
data/genes.db
data/cmd.json
data/status.json
!data/samples/

# Claude Code 的本地工作配置，不属于项目交付物
CLAUDE.md
CLAUDE.local.md
.claude/

.DS_Store

# Each product worktree owns its local database; never commit personal records.
data/product/
